{
  "manifest_version": 3,
  "name": "Flee Autofill",
  "version": "1.0",
  "description": "Autofills the Park University registration form when the extension icon is clicked.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://parkuniversity.my.site.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Run Flee Autofill"
  },
  "content_scripts": [
    {
      "matches": ["https://parkuniversity.my.site.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
