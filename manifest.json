{
  "manifest_version": 3,
  "name": "Flee Autofill",
  "version": "1.0",
  "description": "Autofills the Park University registration form when the extension icon is clicked.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://parkuniversity.my.site.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16":  "icons/icon16.png",
    "32":  "icons/icon32.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Run Flee Autofill",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://parkuniversity.my.site.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
